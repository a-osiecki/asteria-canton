{
  "name": "Asteria Canton",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": false
    }
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "forwardPorts": [2975, 3975, 2001, 3001],
  "portsAttributes": {
    "2975": {
      "label": "Canton JSON API (app-user)",
      "onAutoForward": "silent",
      "visibility": "public"
    },
    "3975": {
      "label": "Canton JSON API (app-provider)",
      "onAutoForward": "silent",
      "visibility": "public"
    },
    "2001": {
      "label": "Wallet app-user",
      "onAutoForward": "silent",
      "visibility": "public"
    },
    "3001": {
      "label": "Wallet app-provider",
      "onAutoForward": "silent",
      "visibility": "public"
    }
  },
  "postCreateCommand": "bash -lc 'cd asteria/cli && npm install && npm run build'"
}