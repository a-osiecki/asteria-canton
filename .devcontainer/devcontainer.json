{
  "name": "Asteria Canton",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "forwardPorts": [2975, 3975],
  "portsAttributes": {
    "2975": {
      "label": "Canton JSON API (app-user)",
      "onAutoForward": "silent",
      "visibility": "public"
    },
    "3975": {
      "label": "Canton JSON API (app-provider)",
      "onAutoForward": "silent",
      "visibility": "public"
    }
  },
  "postCreateCommand": "bash -lc 'cd asteria/cli && npm install && npm run build'"
}