# Variables del devnet de Asteria.

# Docker Compose
DOCKER_NETWORK=asteria
# Formato <company>-<role>-<number>. Los validator apps derivan sus hints como
# app_user_- y app_provider_- + PARTY_HINT, y Splice exige al menos tres
# componentes separados por guiones.
PARTY_HINT=asteria-localparty-1
IMAGE_TAG=0.6.11

# Conexion desde el CLI. Cambiar HOST por la IP publica del servidor.
HOST=localhost
APP_PROVIDER_JSON_PORT=3975
APP_USER_JSON_PORT=2975

# Puertos de las UIs de wallet (nginx). El 2000/3000 del Codespace suele estar ocupado.
APP_USER_UI_PORT=2001
APP_PROVIDER_UI_PORT=3001
SV_UI_PORT=4001

# Autenticacion de LocalNet (modo unsafe)
AUTH_AUDIENCE=https://canton.network.global
LEDGER_USER=ledger-api-user

# DAR de Asteria
DAR_RELATIVE=../daml/contracts/.daml/dist/asteria-contracts-0.1.0.dar
PACKAGE_ID=54599c06d2263d0e8c92bbd6696f9fc2a4b283cc16888b8a281fbd40ac4e138b